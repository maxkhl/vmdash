# ---- Docker Compose ----------------------------------------------------------
# GID der Gruppe des libvirt-Sockets (auf dem Host: stat -c %g /var/run/libvirt/libvirt-sock)
LIBVIRT_SOCK_GID=
# UID/GID, mit der der Container läuft. Muss auf dem HOST existieren, weil
# libvirtd die UID des Aufrufers nachschlägt (auf dem Host: id -u; id -g)
VMDASH_UID=1000
VMDASH_GID=1000
# Wo der Container-Port veröffentlicht wird (Standard: nur lokal für den NPM)
VMDASH_PUBLISH=127.0.0.1:8000

# ---- vmdash (Defaults; einzige Abweichung: BACKEND fest auf libvirt) ---------
# Im Container immer 8000 (docker-compose.yml setzt das); nur für lokalen Start
VMDASH_PORT=8000
# auto = libvirt versuchen, sonst Mock (Default). Im Betrieb fest "libvirt",
# damit ein Verbindungsproblem nicht still im Mock-Modus endet.
VMDASH_BACKEND=libvirt
VMDASH_LIBVIRT_URI=qemu:///system
VMDASH_PROMPT_REGEX=Please unlock disk (\S+):
VMDASH_SUCCESS_REGEX=cryptsetup: (\S+): set up successfully
VMDASH_FAIL_REGEX=cryptsetup: ERROR: \S+: cryptsetup failed
VMDASH_PROMPT_TIMEOUT=120
VMDASH_UNLOCK_TIMEOUT=30
VMDASH_TEMPLATE_VM=sap-template
VMDASH_CLONE_PREFIX=kunde-
VMDASH_STORAGE_POOL=default
VMDASH_VNC_PORT_MIN=5910
VMDASH_VNC_PORT_MAX=5919
VMDASH_LUKS_DEVICE=/dev/vda3
VMDASH_AGENT_TIMEOUT=180
# libvirt-Netz der VMs (DHCP-Reservierungen für die IP und beim Klonen)
VMDASH_LIBVIRT_NETWORK=default
# RD Gateway für "Verbinden" (leer = Funktion aus), z. B. https://rdpgw.maxkhl.com
VMDASH_RDPGW_URL=
VMDASH_RDP_PORT=3389
VMDASH_LOG_LEVEL=INFO

# ---- Nur Mock-Modus (Entwicklung) --------------------------------------------
# Grundverzögerung der Simulation in Sekunden
VMDASH_MOCK_DELAY=1.0
# Schritt, der absichtlich fehlschlägt: clone_volume, define, dhcp, unlock_old,
# agent, luks_add_key, hostname, xrdp_cert, machine_id, ssh_keys, unlock_new,
# luks_remove_key
VMDASH_MOCK_FAIL_STEP=
